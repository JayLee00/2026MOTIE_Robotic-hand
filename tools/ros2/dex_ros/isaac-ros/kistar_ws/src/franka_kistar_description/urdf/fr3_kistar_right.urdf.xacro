<!-- Standalone instantiation guard for AC3 verification. -->
<xacro:if value="$(arg standalone)">
  <link name="$(arg connected_to)"/>
  <xacro:fr3_kistar_right
    prefix="$(arg prefix)"
    connected_to="$(arg connected_to)"
    xyz="$(arg xyz)"
    rpy="$(arg rpy)"
    hand_mount_rpy="$(arg hand_mount_rpy)"/>
</xacro:if>

</robot>
