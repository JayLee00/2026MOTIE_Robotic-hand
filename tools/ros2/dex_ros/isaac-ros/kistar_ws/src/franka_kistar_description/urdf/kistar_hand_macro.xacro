      <origin xyz="0.01338 0.00095 -0.00207" rpy="0. 0. 0."/>
      <mass value="0.01904"/>
      <inertia ixx="0.0000012" ixy="0.0000003" ixz="-0.0000006" iyy="0.0000055" iyz="-0." izz="0.0000051"/>
