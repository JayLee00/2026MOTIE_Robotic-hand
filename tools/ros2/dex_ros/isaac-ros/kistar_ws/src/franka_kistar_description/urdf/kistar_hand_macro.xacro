<?xml version="1.0" encoding="UTF-8"?>
<!-- Right hand macro with prefix support.
     To create a left hand version, copy this file to kistar_l_hand_macro.xacro,
     replace mesh filenames with left-hand meshes, and adjust joint origins/axes
     as needed. The macro interface (prefix param, link/joint naming) must stay
     the same so that the parent URDF and SRDF work with either hand. -->
<robot name="kistar_hand_macro" xmlns:xacro="http://www.ros.org/wiki/xacro">

<xacro:macro name="kistar_hand" params="prefix:=''">

  <!-- ==================== ROOT / MOUNT / PALM ==================== -->
  <link name="${prefix}kistar_hand"/>

  <joint name="${prefix}root_joint" type="fixed">
    <origin xyz="0. 0. 0." rpy="0. 0. 0."/>
    <parent link="${prefix}kistar_hand"/>
    <child link="${prefix}mount"/>
  </joint>

  <link name="${prefix}mount">
    <visual>
      <origin xyz="0. 0. 0." rpy="0. 0. 0."/>
      <geometry>
        <mesh filename="package://franka_kistar_description/meshes/hand/mount_visuals.obj" scale="1. 1. 1."/>
      </geometry>
    </visual>
  </link>

  <joint name="${prefix}kistar_mount_joint" type="fixed">
    <origin xyz="-0.01 0. 0.071 " rpy="0. 0. 0."/>
    <parent link="${prefix}mount"/>
    <child link="${prefix}palm"/>
  </joint>

  <link name="${prefix}palm">
    <inertial>
      <origin xyz="-0.01669 0.00079 -0.02862" rpy="0. 0. 0."/>
      <mass value="0.15476"/>
      <inertia ixx="0.0003271" ixy="-0.0000105" ixz="0.0000539" iyy="0.000351" iyz="-0.0000034" izz="0.0001632"/>
    </inertial>
    <visual>
      <origin xyz="0. 0. 0." rpy="0. 0. 0."/>
      <geometry>
        <mesh filename="package://franka_kistar_description/meshes/hand/palm_visuals.obj" scale="1. 1. 1."/>
      </geometry>
    </visual>
    <collision>
      <origin xyz="0.01070 0.0 -0.02702" rpy="0. 0. 0."/>
      <geometry>
        <box size="0.04700 0.08954 0.08512"/>
      </geometry>
    </collision>
  </link>

  <!-- ==================== INDEX FINGER ==================== -->
  <joint name="${prefix}index_base_joint" type="fixed">
    <origin xyz="0. 0.02883 -0.00126" rpy="-0.0873 0. 0. "/>
    <parent link="${prefix}palm"/>
    <child link="${prefix}index_basemotor"/>
  </joint>

  <joint name="${prefix}index_joint_0" type="revolute">
    <origin xyz="0.02325 0. 0.0047 " rpy="0.0000013 0. 0. "/>
    <parent link="${prefix}index_basemotor"/>
    <child link="${prefix}index_link_0"/>
    <axis xyz="1. 0. 0."/>
    <limit lower="-0.261799" upper="0.261799" effort="0.2" velocity="6.283"/>
  </joint>

  <joint name="${prefix}index_joint_1" type="revolute">
    <origin xyz="0.002 0. 0.019" rpy="0. 0. 0."/>
    <parent link="${prefix}index_link_0"/>
    <child link="${prefix}index_link_1"/>
    <axis xyz="0. 1. 0."/>
    <limit lower="0." upper="1.5707999" effort="0.2" velocity="6.283"/>
  </joint>

  <joint name="${prefix}index_joint_2" type="revolute">
    <origin xyz="0. 0. 0.0335" rpy="0. 0. 0."/>
    <parent link="${prefix}index_link_1"/>
    <child link="${prefix}index_link_2"/>
    <axis xyz="0. 1. 0."/>
    <limit lower="0." upper="1.5707999" effort="0.2" velocity="6.283"/>
