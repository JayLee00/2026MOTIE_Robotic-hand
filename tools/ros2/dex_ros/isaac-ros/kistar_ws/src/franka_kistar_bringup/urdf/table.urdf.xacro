<?xml version="1.0"?>
<robot name="table_env" xmlns:xacro="http://www.ros.org/wiki/xacro">

  <!-- (선택) material을 이름으로 관리하고 싶으면 이렇게 정의해도 됨 -->
  <material name="mid_gray">
    <color rgba="0.55 0.55 0.55 1.0"/>
  </material>
  <material name="dark_gray">
    <color rgba="0.20 0.20 0.20 1.0"/>
  </material>
  <material name="collision_red">
    <color rgba="1.0 0.0 0.0 1.0"/>
  </material>

  <link name="table_link"/>

  <link name="table_top">
    <visual>
      <origin xyz="-0.185 -0.8 -0.75" rpy="0 0 0"/>
      <geometry>
        <mesh filename="package://franka_kistar_bringup/meshes/table/btable.STL" scale="0.001 0.001 0.001"/>
      </geometry>
      <material name="mid_gray"/>
    </visual>

    <collision>
      <origin xyz="0.05 0. -0.35" rpy="0 0 0"/>
      <geometry>
        <box size="1.0 1.8 0.7"/>
      </geometry>
      <material name="collision_red"/>
    </collision>
  </link>

  <joint name="table_top_joint" type="fixed">
    <parent link="table_link"/>
    <child link="table_top"/>
    <origin xyz="0 0 0" rpy="0 0 0"/>
  </joint>

  <link name="franka_support_body">
    <visual>
      <!-- <origin xyz="0 0 0" rpy="0 0 0"/> -->
      <origin xyz="-0.12 -0.243 0" rpy="1.5708 0 1.5708"/>
      <geometry>
        <mesh filename="package://franka_kistar_bringup/meshes/new_table/Franka_support_body.STL" scale="0.001 0.001 0.001"/>
      </geometry>
      <material name="dark_gray"/>
    </visual>
  </link>

  <joint name="franka_support_body_joint" type="fixed">
    <parent link="table_link"/>
    <child link="franka_support_body"/>
    <origin xyz="0 0 0" rpy="0 0 0"/>
  </joint>

</robot>
